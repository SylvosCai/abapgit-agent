#!/usr/bin/env node
/**
 * ABAP Git Agent - CLI Tool
 *
 * Usage:
 *   abapgit-agent init --folder <folder> --package <package>  # Initialize: copies config, CLAUDE.md, guidelines
 *   abapgit-agent init --update                               # Update existing files to latest version
 *   abapgit-agent create
 *   abapgit-agent delete
 *   abapgit-agent import [--message <message>]
 *   abapgit-agent pull [--branch <branch>]
 *   abapgit-agent pull --url <git-url> [--branch <branch>]
 *   abapgit-agent health
 *   abapgit-agent status
 *
 * Auto-detects git remote URL and branch from current directory.
 */

const pathModule = require('path');
const fs = require('fs');
const { parseGlobal, createConnectionContext } = require('../src/utils/connection-context');

// Import utilities
const gitUtils = require('../src/utils/git-utils');
const versionCheck = require('../src/utils/version-check');
const validators = require('../src/utils/validators');
const { AbapHttp } = require('../src/utils/abap-http');
const { loadConfig, getTransport, isAbapIntegrationEnabled, getSafeguards, getConflictSettings, getTransportSettings, getScratchWorkspace, getInspectConfig, getTimeoutMs } = require('../src/config');

// Get terminal width for responsive table
const getTermWidth = () => process.stdout.columns || 80;
const TERM_WIDTH = getTermWidth();

async function main() {
  const { args, override: logonClient } = parseGlobal(process.argv.slice(2));
  const command = args[0];

  const commandModules = require('../src/commands/index');

  // Handle --version / -v
  if (command === '--version' || command === '-v') {
    console.log(versionCheck.getCliVersion());
    return;
  }

  // Check if this is a modular command
  if (commandModules[command] || command === '--help' || command === '-h') {
    const cmd = command === '--help' || command === '-h' ? commandModules.help : commandModules[command];

    const offline = args.includes('--help') || args.includes('-h') || ['system', 'logon', 'credential'].includes(command);
    // Help and catalog operations must not trigger connection or version probes.
    if (!offline && cmd.requiresAbapConfig && !isAbapIntegrationEnabled()) {
      console.log(`
⚠️  ABAP Git Agent not configured for this repository.

To enable integration:
1. Create a .abapGitAgent file in the repo root with ABAP connection details:
{
  "host": "your-sap-system.com",
  "sapport": 443,
  "client": "100",
  "user": "TECH_USER",
  "password": "your-password",
  "language": "EN"
}

2. Or set environment variables:
   - ABAP_HOST, ABAP_PORT, ABAP_CLIENT, ABAP_USER, ABAP_PASSWORD
`);
      process.exit(1);
    }

    const needsConnection = !offline && (cmd.requiresAbapConfig ||
      (command === 'status' && isAbapIntegrationEnabled()) ||
      (command === 'upgrade' && !args.includes('--cli-only') && !args.includes('--check') && isAbapIntegrationEnabled()));
    const connection = needsConnection ? await createConnectionContext(loadConfig(), logonClient) : null;
    if (!offline && !needsConnection && logonClient !== undefined) {
      throw new Error('--logon-client requires a SAP command or logon metadata operation');
    }
    const config = connection?.config ?? null;

    // Version check if needed
    if (!offline && cmd.requiresVersionCheck && config) {
      await versionCheck.checkCompatibility(config);
    }

    // Build context for command
    const context = {
      config,
      gitUtils,
      validators,
      versionCheck,
      isAbapIntegrationEnabled,
      loadConfig: connection?.loadConfig || loadConfig,
      loadRawConfig: loadConfig,
      logonClient,
      resolveGitCredentials: connection?.resolveGitCredentials,
      resolveSapClient: connection?.resolveSapClient,
      AbapHttp,
      getTransport: connection ? () => config.transport || null : getTransport,
      getSafeguards,
      getConflictSettings,
      getTransportSettings,
      getScratchWorkspace: connection ? () => getScratchWorkspace(config) : getScratchWorkspace,
      getInspectConfig,
      getTimeoutMs
    };

    // Execute command
    await cmd.execute(args.slice(1), context);

    // Show new version reminder (non-blocking, cached daily)
    if (!offline && command !== 'upgrade') {
      await versionCheck.showNewVersionReminder();
    }
    return;
  }

  // Unknown command - show error
  console.error(`Unknown command: ${command}`);
  console.error('Run "abapgit-agent help" for usage information');
  process.exit(1);
}

main().catch((err) => {
  // Known CLI errors (e.g. pull conflict) already printed their own output — skip re-printing.
  // For all other unexpected errors, print the message without the stack trace.
  if (!err._isPullError && !err._isTransportError) {
    console.error(err.message || err);
  }
  process.exit(1);
});
